#include <string>
#include <vector>
#include <algorithm>

using namespace std;

string toBaseN(int num, int n)
{
    if (num == 0) return "0";
    string res = "";
    string chars = "0123456789ABCDEF";
    
    while(num > 0)
    {
        res += chars[num % n];
        num /= n;
    }
    
    reverse(res.begin(), res.end());
    return res;
}

string solution(int n, int t, int m, int p) {
    string answer = "";
    string total_str = "";
    
    int num = 0;
    int max_length = t * m;
    
    while(total_str.length() < max_length)
    {
        total_str += toBaseN(num++, n);
    }
    
    for(int i = 0; i < t; i++)
    {
        answer += total_str[(p - 1) + (i * m)];
    }
    
    return answer;
}
