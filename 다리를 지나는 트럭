#include <string>
#include <vector>
#include <queue>

using namespace std;

int solution(int bridge_length, int weight, vector<int> truck_weights) {

    int time = 0;
    int current_bridge_weight = 0;
    queue<int> bridge;
    
    int truck_idx = 0;
    
    while(true)
    {
        
        if(truck_idx == truck_weights.size() && current_bridge_weight == 0)
        {
            break;
        }
        
        time++;
        
        if(bridge.size() == bridge_length)
        {

            current_bridge_weight -= bridge.front();
            bridge.pop();
            
        }
        
        if(truck_idx < truck_weights.size())
        {
            
            if(current_bridge_weight + truck_weights[truck_idx] <= weight)
            {
                bridge.push(truck_weights[truck_idx]);
                current_bridge_weight += truck_weights[truck_idx];
                truck_idx++;
            }
            else
            {
                bridge.push(0);
            }
        }
        else
        {
            bridge.push(0);
        }
    }
    
    return time;
}
