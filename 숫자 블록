#include <string>
#include <vector>

using namespace std;

long long getMaxDivisor(long long n)
{
    if (n == 1) return 0;
    
    long long max_div = 1;
    
    for(long long i = 2; i * i <= n; i++)
    {
        if(n % i == 0)
        {
            if(n / i <= 10000000)
            {
                return n / i;
            }
            if(i <= 10000000)
            {
                max_div = i;
            }
        }
    }
    
    return max_div;
}

vector<int> solution(long long begin, long long end) {
    vector<int> answer;
    
    for(long long i = begin; i <= end; i++)
    {
        answer.push_back(getMaxDivisor(i));
    }
    
    return answer;
}
