#include <string>
#include <vector>
#include <iostream>
#include <unordered_set>

using namespace std;

vector<int> solution(int n, vector<string> words) {

    unordered_set<string> seen;
    
    seen.insert(words[0]);
    
    for(size_t i = 1; i < words.size(); i++)
    {

        if(words[i][0] != words[i-1].back() || seen.count(words[i]))
        {
            
            int person = (i % n) + 1;
            int turn = (i / n) + 1;
            return {person, turn};
            
        }
        
        seen.insert(words[i]);
    }
    
    return {0, 0};
}
