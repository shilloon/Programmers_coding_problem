#include <string>
#include <vector>
#include <list>
#include <algorithm>

using namespace std;

string toLowerStr(string s)
{
    
    for(char &c : s)
    {
        
        c = tolower(c);
        
    }
    
    return s;
}

int solution(int cacheSize, vector<string> cities) {
    
    int total_time = 0;
    
    if (cacheSize == 0)
    {
        
        return cities.size() * 5;
        
    }
    
    
    list<string> cache;
    
    for(string city : cities)
    {
        
        city = toLowerStr(city);
        
        auto it = find(cache.begin(), cache.end(), city);
        
        if(it != cache.end())
        {
            
            total_time += 1;
            
            cache.erase(it);
            cache.push_front(city);
            
        }
        else
        {
            
            total_time += 5;
            
            if(cache.size() >= cacheSize)
            {
                cache.pop_back();
            }
            
            cache.push_front(city);
        }
    }
    
    return total_time;
}
